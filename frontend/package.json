    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^16.6.6",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "react-select": "^5.10.2",
